<% if (errors.length > 0) { %>
    <div class="alert alert-error" role="alert">
        <strong>Проверьте заполнение формы:</strong>
        <ul>
            <% errors.forEach((error) => { %><li><%= error %></li><% }) %>
        </ul>
    </div>
<% } %>

<form class="course-form" action="<%= action %>" method="POST">
    <label>
        Название дисциплины
        <input type="text" name="title" value="<%= course.title || '' %>" required>
    </label>
    <label>
        Преподаватель
        <input type="text" name="teacher" value="<%= course.teacher || '' %>" required>
    </label>
    <div class="form-grid">
        <label>
            Количество кредитов
            <input type="number" name="credits" min="1" step="1" value="<%= course.credits || '' %>" required>
        </label>
        <label>
            Семестр
            <select name="semester" required>
                <option value="">Выберите семестр</option>
                <% for (let value = 1; value <= 8; value += 1) { %>
                    <option value="<%= value %>" <%= Number(course.semester) === value ? 'selected' : '' %>><%= value %></option>
                <% } %>
            </select>
        </label>
    </div>
    <label>
        Описание
        <textarea name="description" rows="5" required><%= course.description || '' %></textarea>
    </label>
    <button class="button button-primary" type="submit"><%= submitLabel %></button>
</form>
